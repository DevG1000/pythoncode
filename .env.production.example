# 生产环境配置示例
# 重要：不要提交此文件到版本控制，使用环境变量

# Flask Configuration
FLASK_APP=api/app.py
FLASK_ENV=production
FLASK_DEBUG=0
# SECRET_KEY 应该从环境变量设置，不要硬编码
# export SECRET_KEY=$(openssl rand -hex 32)

# Database Configuration
# PostgreSQL with SSL
DATABASE_URL=postgresql://user:password@localhost/dbname?sslmode=require

# Redis Configuration
REDIS_URL=redis://localhost:6379/0

# Email Configuration
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
# MAIL_USERNAME and MAIL_PASSWORD should be set as environment variables

# Security Configuration
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_HTTPONLY=true
SESSION_COOKIE_SAMESITE=Lax
PERMANENT_SESSION_LIFETIME=900  # 15 minutes in seconds

# Rate Limiting
RATELIMIT_ENABLED=true
RATELIMIT_DEFAULT=100 per minute
RATELIMIT_STORAGE_URL=redis://localhost:6379/1

# CORS Configuration
CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
CORS_SUPPORTS_CREDENTIALS=true

# Logging Configuration
LOG_LEVEL=WARNING
LOG_FILE=/var/log/pythoncode/app.log
LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s

# Application Configuration
APP_NAME=BusinessCardGenerator
VERIFICATION_TOKEN_EXPIRY=86400  # 24 hours in seconds
PASSWORD_MIN_LENGTH=12
MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCKOUT_TIME=900  # 15 minutes in seconds

# Monitoring
SENTRY_DSN=https://your-sentry-dsn@sentry.io/your-project
NEW_RELIC_LICENSE_KEY=your-license-key

# External APIs (if any)
# API_KEY should be set as environment variable

# 部署配置
DEPLOYMENT_ENV=production
INSTANCE_NAME=pythoncode-prod-01
REGION=us-east-1

# 备份配置
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *  # Daily at 2 AM
BACKUP_RETENTION_DAYS=30

# 注意：
# 1. 所有敏感信息（密码、密钥、令牌）应该通过环境变量设置
# 2. 生产环境不要使用硬编码的凭证
# 3. 定期轮换密钥和密码
# 4. 启用所有安全功能（HTTPS、CORS、速率限制等）